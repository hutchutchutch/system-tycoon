{
  "name": "tycoon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "dev:all": "wrangler dev & vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build && npm run check:build",
    "check:build": "node scripts/check-build.mjs",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply system-tycoon-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply system-tycoon-db --remote",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "worker:types": "wrangler types worker/worker-configuration.d.ts",
    "worker:types:check": "wrangler types worker/worker-configuration.d.ts --check",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "check": "npm run lint && npm test && npm run build && npm run typecheck:worker && npm run worker:types:check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@xyflow/react": "^12.12.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "framer-motion": "^14.0.0",
    "hono": "^4.13.13",
    "kysely": "^0.29.6",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-fast-marquee": "^1.6.5",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "es-module-lexer": "3.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "30.1.2",
    "miniflare": "5.20260903.0-alpha",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0"
  }
}
