{
  "name": "tycoon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "dev:all": "wrangler dev & vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply system-tycoon-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply system-tycoon-db --remote",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "worker:types": "wrangler types worker/worker-configuration.d.ts",
    "worker:types:check": "wrangler types worker/worker-configuration.d.ts --check",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "check": "npm run lint && npm test && npm run build && npm run typecheck:worker && npm run worker:types:check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@reduxjs/toolkit": "^2.12.0",
    "@xyflow/react": "^12.11.6",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "framer-motion": "^13.2.0",
    "hono": "^4.13.5",
    "kysely": "^0.29.5",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-aria-components": "^1.21.0",
    "react-dom": "^19.2.8",
    "react-fast-marquee": "^1.6.5",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "30.0.1",
    "miniflare": "5.20260903.0-alpha",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
