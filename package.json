{
  "name": "tycoon",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "dev:all": "wrangler dev & vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply system-tycoon-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply system-tycoon-db --remote",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "worker:types": "wrangler types worker/worker-configuration.d.ts",
    "worker:types:check": "wrangler types worker/worker-configuration.d.ts --check",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json",
    "check": "npm run lint && npm test && npm run build && npm run typecheck:worker && npm run worker:types:check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@reduxjs/toolkit": "^2.8.2",
    "@xyflow/react": "^12.8.2",
    "better-auth": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^0.6.4",
    "framer-motion": "^12.23.6",
    "hono": "^4.13.5",
    "kysely": "^0.28.16",
    "kysely-d1": "^0.4.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-aria-components": "^1.10.1",
    "react-dom": "^19.1.0",
    "react-fast-marquee": "^1.6.5",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.3.1"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@eslint/js": "^9.30.1",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^24.0.13",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "27.4.0",
    "miniflare": "5.20260903.0-alpha",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
